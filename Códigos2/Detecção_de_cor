import cv2
from PIL import Image
from funcaocor import get_limits

Amarelo = [0,255,255] #Amarelo em BGR

webcam = cv2.VideoCapture(2)

while True:
    #ler o video da webcam
    ret, frame = webcam.read()
    #Usado para rotacionar a camera frontal do celular
    frame = cv2.rotate(frame, cv2.ROTATE_90_CLOCKWISE)
    hsvimage = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)

    limiteinferior, limitesuperior = get_limits(color=Amarelo)

    mask = cv2.inRange(hsvimage, limiteinferior, limitesuperior)
    mask_ = Image.fromarray(mask)
    bbox = mask_.getbbox()
    if bbox is not None:
        x1, y1, x2, y2 = bbox
        frame = cv2.rectangle(frame, (x1, y1), (x2, y2), (0,0,0), 5)
    cv2.imshow('frame', frame)
    cv2.imshow('mask', mask)
    #fecha a webcam quando pressionar q
    if cv2.waitKey(40) & 0xFF == ord('q'):
        break

webcam.release()
cv2.destroyAllWindows()

